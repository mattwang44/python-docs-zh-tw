msgstr "``%(taskName)s``"

#: ../../library/logging.rst:1069
msgid ":class:`asyncio.Task` name (if available)."
msgstr ":class:`asyncio.Task` 名稱（如果可用）。"

#: ../../library/logging.rst:1072
